# Single env file for the whole backend (Users + Agents + API Gateway).
# Copy to .env for local runs; on Hugging Face Spaces set these as Secrets/Variables.

# App
# "development" enables uvicorn's auto-reload (single process); any other value
# (e.g. "production") runs without it and honors WORKERS (per service).
ENVIRONMENT=development
LOG_LEVEL=INFO
WORKERS=1

# Ports. Only PORT (the API Gateway) is public; Users and Agents listen on
# 127.0.0.1 inside the container. 7860 is the port Hugging Face Spaces exposes.
PORT=7860
USERS_PORT=8001
AGENTS_PORT=8002

# Service-to-service URLs. Leave unset: run_all.py points them at the
# in-container Users/Agents processes.
# USERS_SERVICE_URL=http://127.0.0.1:8001
# AGENTS_SERVICE_URL=http://127.0.0.1:8002

# MongoDB (one cluster, one database per service)
MONGO_URI=mongodb://localhost:27017
USERS_MONGO_DB_NAME=bolotext_users
AGENTS_MONGO_DB_NAME=bolotext_agents

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Google Sign-In — OAuth 2.0 Web client id; must equal the frontend's VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=857323365742-tmd4esvqfjemm4h3bh73cpttsnbmmrl0.apps.googleusercontent.com

# Shared secret for the internal token-introspection endpoint (Users <-> Agents).
INTERNAL_API_KEY=replace-with-a-long-random-secret
INTROSPECT_TIMEOUT_SECONDS=5.0

# Login rate limiting (slowapi syntax, e.g. "5/minute")
LOGIN_RATE_LIMIT=5/minute

# Bootstrap Super Admin, created idempotently by the Users seed command.
BOOTSTRAP_SUPER_ADMIN_EMAIL=superadmin@example.com
BOOTSTRAP_SUPER_ADMIN_NAME=Super Admin

# Provider/model registry in-process cache TTL, in seconds.
PROVIDER_CACHE_TTL_SECONDS=300

# Optional Fernet key encrypting stored WhatsApp/Twilio auth tokens; if empty a
# key is derived from INTERNAL_API_KEY.
WHATSAPP_ENCRYPTION_KEY=

# API Gateway
UPSTREAM_TIMEOUT_SECONDS=30
# Optional: pin the gateway's public URL (used for Twilio delivery-status callbacks).
PUBLIC_URL=
