# "development" enables uvicorn's auto-reload (see api_gateway/__init__.py:main);
# any other value (e.g. "production") runs without it and honors WORKERS.
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
# Only used when ENVIRONMENT != development.
WORKERS=4

# Upstream microservices
USERS_SERVICE_URL=http://localhost:8001
AGENTS_SERVICE_URL=http://localhost:8002

UPSTREAM_TIMEOUT_SECONDS=30
