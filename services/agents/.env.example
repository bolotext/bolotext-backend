# App
# "development" enables uvicorn's auto-reload (see agents_service/__init__.py:main);
# any other value (e.g. "production") runs without it and honors WORKERS.
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8002
# Only used when ENVIRONMENT != development.
WORKERS=4

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=bolotext_agents

# Identity is resolved via the Users service's internal introspection
# endpoint rather than decoding JWTs locally.
USERS_SERVICE_URL=http://localhost:8001
# Must be identical to the Users service's own INTERNAL_API_KEY.
INTERNAL_API_KEY=replace-with-a-long-random-secret
INTROSPECT_TIMEOUT_SECONDS=5.0

# Provider/model registry in-process cache TTL, in seconds.
PROVIDER_CACHE_TTL_SECONDS=300

# WhatsApp: Twilio credentials are NOT configured here — each organization sets
# its own in the UI (WhatsApp Messaging > Twilio settings); the auth token is
# stored encrypted. Optional Fernet key used for that encryption (generate with
# `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`);
# if empty a key is derived from INTERNAL_API_KEY.
WHATSAPP_ENCRYPTION_KEY=
