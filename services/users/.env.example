# App
ENVIRONMENT=development
LOG_LEVEL=INFO

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=bolotext_users

# JWT — this secret must be identical wherever a token this service issues is
# verified (the API Gateway today; any future service that checks a role/org
# claim directly instead of going through the gateway).
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Shared secret for the internal token-introspection endpoint used by other
# internal microservices (e.g. the future Agents service).
INTERNAL_API_KEY=replace-with-a-long-random-secret

# Login rate limiting (slowapi syntax, e.g. "5/minute")
LOGIN_RATE_LIMIT=5/minute

# Bootstrap Super Admin, created idempotently by `python main.py seed`.
# Leave unset after the first run in a shared environment.
BOOTSTRAP_SUPER_ADMIN_EMAIL=superadmin@example.com
BOOTSTRAP_SUPER_ADMIN_PASSWORD=change-me-strong-password
BOOTSTRAP_SUPER_ADMIN_NAME=Super Admin
